{
  "name": "salacofre",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web pública de apuração eleitoral 2026 com projeção estatística",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:pre": "FIXTURE_VARIANT=pre next dev",
    "dev:sim": "FIXTURE_VARIANT=sim next dev",
    "dev:sim-velho": "FIXTURE_VARIANT=sim-velho next dev",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "next build",
    "start": "next start",
    "start:e2e": "DATABASE_URL=\"\" DATABASE_URL_UNPOOLED=\"\" POSTGRES_URL=\"\" POSTGRES_URL_NON_POOLING=\"\" POSTGRES_PRISMA_URL=\"\" POSTGRES_URL_NO_SSL=\"\" PGPASSWORD=\"\" POSTGRES_PASSWORD=\"\" BLOB_READ_WRITE_TOKEN=\"\" EDGE_CONFIG_TOKEN=\"\" CRON_SECRET=\"\" MODEL_SECRET=\"\" VERCEL_DEPLOY_HOOK_URL=\"\" EDGE_CONFIG_ID=\"\" EDGE_CONFIG=\"http://127.0.0.1:3101/ecfg_e2efalso?token=e2e\" tsx scripts/edge-config-falso.ts -- next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:py": "python -m pytest",
    "db:generate": "drizzle-kit generate",
    "db:push:DANGEROUS": "drizzle-kit push",
    "db:postgis": "node scripts/apply-postgis.mjs",
    "db:migrate:0006": "node --experimental-strip-types data-pipeline/migrations/0006_pares_municipio_zona.ts && node --experimental-strip-types data-pipeline/migrations/0007_municipio_boa_esperanca_do_norte.ts && node --experimental-strip-types data-pipeline/eleitorado-import.ts && node --experimental-strip-types data-pipeline/zonas-import.ts",
    "db:migrate:0008": "node --experimental-strip-types data-pipeline/migrations/0008_candidatos.ts && node --experimental-strip-types data-pipeline/candidatos-import.ts",
    "db:migrate:0009": "node --experimental-strip-types data-pipeline/migrations/0009_projections_pct_atual.ts",
    "db:migrate:0010": "node --experimental-strip-types data-pipeline/migrations/0010_snapshots_nivel.ts",
    "db:eleitorado:df": "node --experimental-strip-types data-pipeline/eleitorado-df-import.ts",
    "candidatos:import": "node --experimental-strip-types data-pipeline/candidatos-import.ts",
    "candidatos:publish": "tsx data-pipeline/candidatos-publish.ts",
    "candidatos:fotos": "tsx data-pipeline/candidatos-fotos-import.ts",
    "trajetoria:exportar": "node --experimental-strip-types data-pipeline/trajetoria-exportar.ts",
    "alinhamento:importar": "node --experimental-strip-types data-pipeline/alinhamento-importar.ts --corte 2026-09-03",
    "edge-config:smoke": "tsx scripts/edge-config-smoke.ts",
    "edge-config:prune": "tsx scripts/edge-config-prune.ts",
    "projection:seed": "tsx data-pipeline/projection-seed.ts",
    "sim": "tsx data-pipeline/simulacao-gerar.ts",
    "sim:full": "pnpm sim && .venv-model/bin/python3.14 scripts/gerar-serie-fixtures.py && biome format --write tests/fixtures/simulacao",
    "list-targets": "tsx scripts/list-targets.ts",
    "tse:watch": "tsx scripts/tse-watch.ts",
    "tse:mock": "tsx scripts/tse-mock-server.ts",
    "replay-2022": "tsx scripts/replay-2022.ts",
    "replay-2022:sensitivity": "tsx scripts/replay-sensitivity.ts",
    "gen:party-scale": "tsx scripts/gen-party-scale.ts",
    "gen:uf-flags": "tsx scripts/gen-uf-flags.ts",
    "verify-fatia-premise": "tsx scripts/verify-fatia-premise.ts",
    "vigia:ciclo": "tsx scripts/vigia-ciclo.ts",
    "vigia:armado": "tsx scripts/vigia-armado.ts",
    "alerta:teste": "tsx scripts/alerta-teste.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^16.2.6",
    "@vercel/blob": "^2.3.3",
    "@vercel/edge-config": "^1.4.3",
    "botid": "^1.5.11",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "pmtiles": "^4.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "swr": "^2.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "ws": "^8.20.1"
  }
}
